# Set to "false" once your real Node/Express + Socket.io backend is running,
# and the app will call the real API instead of the built-in mock data layer.
VITE_USE_MOCK=true

# Base URL of your Express backend (only used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:5000

# Base URL of your Socket.io server (only used when VITE_USE_MOCK=false)
VITE_SOCKET_URL=http://localhost:5000
